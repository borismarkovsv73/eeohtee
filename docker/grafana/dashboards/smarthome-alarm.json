{
  "title": "Smart Home - Alarm System",
  "uid": "smarthome-alarm",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "ALARM - Entry/Exit Events",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left", "displayMode": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "code" }, "properties": [{ "id": "displayName", "value": "Reason" }] },
          { "matcher": { "id": "byName", "options": "value" }, "properties": [{ "id": "displayName", "value": "Active" }] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Time", "desc": true }] },
      "targets": [
        { "refId": "A", "query": "from(bucket: \"smarthome\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ALARM\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"_time\", \"code\", \"value\"])\n  |> sort(columns: [\"_time\"], desc: true)" }
      ]
    },
    {
      "id": 2,
      "title": "SECURITY - Armed / Disarmed Events",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left", "displayMode": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "code" }, "properties": [{ "id": "displayName", "value": "Event" }] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Time", "desc": true }] },
      "targets": [
        { "refId": "A", "query": "from(bucket: \"smarthome\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"SECURITY\")\n  |> filter(fn: (r) => r._field == \"code\")\n  |> keep(columns: [\"_time\", \"_value\"])\n  |> sort(columns: [\"_time\"], desc: true)" }
      ]
    },
    {
      "id": 3,
      "title": "Occupancy (people in the house)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": true
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        { "refId": "A", "query": "from(bucket: \"smarthome\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"OCCUPANCY\")\n  |> filter(fn: (r) => r._field == \"value\")" }
      ]
    }
  ]
}
