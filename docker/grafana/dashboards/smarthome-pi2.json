{
  "title": "Smart Home - PI2 Sensors & Actuators",
  "uid": "smarthome-pi2",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "DS2 - Door Sensor (Button)",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "special", "options": { "match": "true", "result": { "text": "Pressed", "color": "semi-dark-red" } } },
            { "type": "special", "options": { "match": "false", "result": { "text": "Released", "color": "green" } } }
          ]
        }
      },
      "options": { "mergeValues": true, "showValue": "always", "alignValue": "left", "rowHeight": 0.9, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "query": "from(bucket: \"smarthome\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"DS2\")\n  |> filter(fn: (r) => r._field == \"value\")" }
      ]
    },
    {
      "id": 2,
      "title": "DUS2 - Door Ultrasonic Sensor",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "cm",
          "min": 0,
          "max": 400,
          "custom": {
            "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2,
            "fillOpacity": 15, "showPoints": "always", "pointSize": 5,
            "spanNulls": false, "gradientMode": "opacity"
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        { "refId": "A", "query": "from(bucket: \"smarthome\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"DUS2\")\n  |> filter(fn: (r) => r._field == \"value\")" }
      ]
    },
    {
      "id": 3,
      "title": "DPIR2 - Door Motion Sensor",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "special", "options": { "match": "true", "result": { "text": "Motion", "color": "orange" } } },
            { "type": "special", "options": { "match": "false", "result": { "text": "Clear", "color": "green" } } }
          ]
        }
      },
      "options": { "mergeValues": true, "showValue": "always", "alignValue": "left", "rowHeight": 0.9, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "query": "from(bucket: \"smarthome\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"DPIR2\")\n  |> filter(fn: (r) => r._field == \"value\")" }
      ]
    },
    {
      "id": 4,
      "title": "BTN - Kitchen Button",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "special", "options": { "match": "true", "result": { "text": "Pressed", "color": "blue" } } },
            { "type": "special", "options": { "match": "false", "result": { "text": "Released", "color": "dark-gray" } } }
          ]
        }
      },
      "options": { "mergeValues": true, "showValue": "always", "alignValue": "left", "rowHeight": 0.9, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "query": "from(bucket: \"smarthome\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"BTN\")\n  |> filter(fn: (r) => r._field == \"value\")" }
      ]
    },
    {
      "id": 5,
      "title": "DHT3 - Kitchen Temperature & Humidity",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto", "spanNulls": true },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "query": "from(bucket: \"smarthome\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"DHT3\")" }
      ]
    },
    {
      "id": 6,
      "title": "GSG - Gyroscope / Vibration",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "special", "options": { "match": "true", "result": { "text": "Movement", "color": "red" } } },
            { "type": "special", "options": { "match": "false", "result": { "text": "Still", "color": "green" } } }
          ]
        }
      },
      "options": { "mergeValues": true, "showValue": "always", "alignValue": "left", "rowHeight": 0.9, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "query": "from(bucket: \"smarthome\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"GSG\")\n  |> filter(fn: (r) => r._field == \"value\")" }
      ]
    },
    {
      "id": 7,
      "title": "4SD - Kitchen Timer Display",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "custom": { "align": "left", "displayMode": "auto" } } },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Time", "desc": true }] },
      "targets": [
        { "refId": "A", "query": "from(bucket: \"smarthome\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"4SD\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"_time\", \"display\", \"blinking\"])\n  |> sort(columns: [\"_time\"], desc: true)" }
      ]
    }
  ]
}
